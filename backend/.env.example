# Copie para backend/.env e preencha. O .env nunca vai para o git (.gitignore).
# Valores sem segredo já vêm preenchidos; os demais ficam vazios de propósito.

# --- Servidor (D23) ---
NODE_ENV=development
PORTA=3000
# "log" escreve SMS/e-mail no log do servidor (D16). O servidor recusa "log" em produção.
ENVIADOR_MENSAGEM=log

# --- Produção (D40) ---
# Quem está na frente da API, para o limite por IP ver o IP de quem pediu. Vazio = nenhum proxy (desenvolvimento).
# Número = quantos proxies na frente (ex.: 1 atrás de um Nginx). Ou lista de IPs/sub-redes: 10.0.0.0/8,loopback.
PROXY_CONFIAVEL=
# Dias que tentativas de login, códigos e sessões mortas ficam guardados ("npm run limpar:dados").
# Vazio = 90 (pendente de confirmação com a Colzani, docs/pendencias-colzani.md).
RETENCAO_DIAS=

# --- Segredos (mínimo de 32 caracteres cada, um diferente do outro) ---
JWT_SEGREDO=
CODIGO_HMAC_SEGREDO=

# --- Postgres do Docker Compose (D8, D25.13) ---
# Lidas pelo docker-compose.yml desta pasta. Use senha só com letras e números:
# ela também entra nas URLs abaixo, onde símbolos precisariam de escape.
POSTGRES_USER=
POSTGRES_PASSWORD=
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5433/dentagenda
DATABASE_URL=
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5433/dentagenda_test
DATABASE_URL_TESTE=

# --- Primeiro admin, lidas só por "npm run db:seed" (D23, D25.12) ---
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_NOME=
# 11 dígitos com dígito verificador válido (D25.1)
ADMIN_INICIAL_CPF=
# RECEPCIONISTA ou DENTISTA
ADMIN_INICIAL_CATEGORIA=
# Só se a categoria for DENTISTA (ex.: SP-12345)
ADMIN_INICIAL_CRO=
