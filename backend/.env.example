# Copie para backend/.env e preencha. O .env nunca vai para o git (.gitignore).
# Valores sem segredo já vêm preenchidos; os demais ficam vazios de propósito.

# --- Servidor (D23) ---
NODE_ENV=development
PORTA=3000
# "log" escreve SMS/e-mail no log do servidor (D16). O servidor recusa "log" em produção.
ENVIADOR_MENSAGEM=log

# --- Segredos (mínimo de 32 caracteres cada, um diferente do outro) ---
JWT_SEGREDO=
CODIGO_HMAC_SEGREDO=

# --- Postgres do Docker Compose (D8, D25.13) ---
# Lidas pelo docker-compose.yml desta pasta. Use senha só com letras e números:
# ela também entra nas URLs abaixo, onde símbolos precisariam de escape.
POSTGRES_USER=
POSTGRES_PASSWORD=
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/dentagenda
DATABASE_URL=
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/dentagenda_test
DATABASE_URL_TESTE=

# --- Primeiro admin, lidas só por "npm run db:seed" (D23, D25.12) ---
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_NOME=
# 11 dígitos com dígito verificador válido (D25.1)
ADMIN_INICIAL_CPF=
# RECEPCIONISTA ou DENTISTA
ADMIN_INICIAL_CATEGORIA=
# Só se a categoria for DENTISTA (ex.: SP-12345)
ADMIN_INICIAL_CRO=
