Cliente
  id            INT PK
  nome          NOT NULL
  cpf           VARCHAR(14) UNIQUE, NOT NULL
  telefone      VARCHAR NOT NULL
  email         VARCHAR
  nascimento    DATE
  convenio      NULL (paciente particular não tem)
  criadoEm      DATE NOT NULL
  pacienteDesde DATE NOT NULL

Login
  id         INT PK
  clienteId  INT FK -> Cliente.id, UNIQUE
  senha      VARCHAR(60) NOT NULL



Funcionários
  id    INT PK
  nome  NOT NULL
  cpf   UNIQUE, NOT NULL
  e-mail  UNIQUE, NOT NULL
  CRO   UNIQUE
  dataInicio  NOT NULL
  senha NOT NULL
  categoria NOT NULL